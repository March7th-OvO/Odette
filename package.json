{
  "name": "odette-image-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\"",
    "dev": "concurrently -k -n worker,web \"wrangler dev --env development --port 8787\" \"vite --host 127.0.0.1\"",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:articles-browser": "node tests/articles-browser.cjs"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "jsonc-parser": "^3.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.1"
  }
}
