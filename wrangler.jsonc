{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "odette",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "IMAGE_BUCKET", "bucket_name": "march7th-assets" }],
  "vars": {
    "APP_ENV": "production",
    "PUBLIC_IMAGE_URL": "https://img.example.com",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "env": {
    "development": {
      "vars": { "APP_ENV": "development", "PUBLIC_IMAGE_URL": "http://127.0.0.1:8787/api/local-images", "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "" },
      "r2_buckets": [{ "binding": "IMAGE_BUCKET", "bucket_name": "image-host" }]
    }
  }
}
